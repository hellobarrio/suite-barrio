<?xml version="1.0"?>
<ruleset name="Barrio Suite">
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/wp-tests-config.php</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<config name="minimum_wp_version" value="6.6"/>

	<!-- WordPress-Extra senza WordPress-Docs: niente docblock obbligatori. -->
	<rule ref="WordPress-Extra">
		<!-- Nomi dei file PSR-4 (src/Database/Migrator.php), non class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
	</rule>
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="barrio"/>
				<element value="BarrioSuite"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="barrio_manage_forms"/>
				<element value="barrio_manage_entries"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="barrio-suite"/>
				<element value="barrio-suite-mailchimp"/>
				<element value="barrio-suite-recaptcha"/>
				<element value="barrio-suite-wpgraphql"/>
			</property>
		</properties>
	</rule>

	<!-- Le query dirette sono il compito di queste classi; altrove restano segnalate. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/src/Database/*</exclude-pattern>
		<exclude-pattern>/src/Requirements.php</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<!-- Db riceve query già preparate dai Repository; i test scrivono SQL a mano apposta. -->
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>/src/Database/Db.php</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
