{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "barrio/company",
	"title": "Company details",
	"category": "widgets",
	"icon": "id",
	"description": "Shows the company details of Barrio Suite, such as the legal line of the footer.",
	"keywords": [ "company", "VAT", "legal", "barrio" ],
	"textdomain": "barrio-suite",
	"attributes": {
		"fields": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": [ "legal_name", "address", "vat_id", "tax_code", "registration_number", "share_capital" ]
		},
		"layout": {
			"type": "string",
			"enum": [ "line", "list" ],
			"default": "line"
		},
		"labels": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"customClassName": false
	},
	"editorScript": "file:./index.js"
}
