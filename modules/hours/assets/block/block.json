{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "barrio/hours",
	"title": "Opening hours",
	"category": "widgets",
	"icon": "clock",
	"description": "Shows the opening hours of Barrio Suite: the week, today or whether it is open now.",
	"keywords": [ "hours", "open", "barrio" ],
	"textdomain": "barrio-suite",
	"attributes": {
		"show": {
			"type": "string",
			"enum": [ "week", "today", "status" ],
			"default": "week"
		},
		"group": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"customClassName": false
	},
	"editorScript": "file:./index.js",
	"style": "barrio-hours"
}
