parameters:
	level: 8
	paths:
		- barrio-suite.php
		- src
		- modules
		- extensions
	scanFiles:
		- tests/wpgraphql.stub
		- tests/wp-cli.stub
	typeAliases:
		BarrioMigrationReport: 'array{counts: list<array{data: string, found: int, migrated: int, skipped: int}>, notes: list<string>, warnings: list<string>}'
