{
	"name": "barrio-suite",
	"files": [
		"barrio-suite.php",
		"src",
		"build",
		"modules/*/src",
		"modules/*/migrations",
		"modules/*/templates",
		"modules/*/assets/frontend",
		"modules/*/assets/block",
		"modules/*/presets.json"
	],
	"private": true,
	"scripts": {
		"env": "wp-env",
		"composer": "wp-env run tests-cli --env-cwd=wp-content/plugins/barrio-suite composer",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/barrio-suite vendor/bin/phpunit",
		"lint:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/barrio-suite composer lint",
		"form": "wp-env run cli --env-cwd=wp-content/plugins/barrio-suite wp --require=dev/cli.php --user=admin barrio forms create",
		"seed": "wp-env run cli --env-cwd=wp-content/plugins/barrio-suite wp --require=dev/cli.php barrio forms seed",
		"mailpit": "docker run -d --rm --name barrio-mailpit --network $(docker network ls -qf name=wp-env-barrio-suite) -e MP_SMTP_AUTH_ACCEPT_ANY=1 -e MP_SMTP_AUTH_ALLOW_INSECURE=1 -p 127.0.0.1:8025:8025 axllent/mailpit:v1.21.8",
		"build": "wp-scripts build forms-admin=./modules/forms/assets/src/admin/index.js --output-path=build",
		"start": "wp-scripts start forms-admin=./modules/forms/assets/src/admin/index.js --output-path=build",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"format": "wp-scripts format",
		"test:js": "node --test 'tests/js/**/*.test.js'",
		"zip": "npm run build && wp-scripts plugin-zip",
		"zip:wpml": "cd extensions && zip -r ../barrio-suite-wpml.zip barrio-suite-wpml"
	},
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@wordpress/env": "^12.1.0",
		"@wordpress/scripts": "^37.1.0"
	},
	"type": "module"
}
