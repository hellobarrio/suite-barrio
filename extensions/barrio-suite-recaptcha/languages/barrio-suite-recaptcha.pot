#. Plugin Name of the plugin
#: barrio-suite-recaptcha.php
msgid "Barrio Suite reCAPTCHA"
msgstr ""

#. Description of the plugin
#: barrio-suite-recaptcha.php
msgid "Invisible reCAPTCHA Enterprise check on the Barrio Suite forms, against spam bots."
msgstr ""

#. Author of the plugin
#: barrio-suite-recaptcha.php
msgid "Hellobarrio"
msgstr ""

#: barrio-suite-recaptcha.php:39
msgid "An invisible check by Google reCAPTCHA Enterprise on every form, with the Google service account of Barrio → Settings. It is off until a site key is chosen."
msgstr ""

#: barrio-suite-recaptcha.php:43
msgid "Site key"
msgstr ""

#: barrio-suite-recaptcha.php:44
msgid "The score-based keys of the Google Cloud project of the service account. The service account needs the reCAPTCHA Enterprise Agent role, and the key must allow the domains of the site."
msgstr ""

#: barrio-suite-recaptcha.php:83
msgid "Add the Google service account in Barrio → Settings first."
msgstr ""

#: barrio-suite-recaptcha.php:168
msgid "Your submission could not be accepted."
msgstr ""

#: barrio-suite-recaptcha.php:187
msgid "The spam check is not available right now. Please try again in a few minutes."
msgstr ""

#: barrio-suite-recaptcha.php:206
msgid "reCAPTCHA is off: there is no Google service account, or it can no longer be read (for example after the site was moved). Add it again in Barrio → Settings."
msgstr ""

#. translators: %s: error from Google, for example "HTTP 403 Permission denied".
#: barrio-suite-recaptcha.php:218
#, php-format
msgid "reCAPTCHA could not check the last form submission, so the form was not sent: %s. Check the service account in Barrio → Settings and the site key in Barrio → Forms → Settings."
msgstr ""
