#. Plugin Name of the plugin
#: barrio-suite-migration.php
msgid "Barrio Suite Migration"
msgstr ""

#. Description of the plugin
#: barrio-suite-migration.php
msgid "Moves the data of Suite Barrio, the previous plugin, to Barrio Suite with one WP-CLI command per module: forms, SEO, popups, banners, opening hours, company details, blocks, ordering, duplicate, alt text and analytics. Once done, it can be removed."
msgstr ""

#. Author of the plugin
#: barrio-suite-migration.php
msgid "Hellobarrio"
msgstr ""

#. translators: %s: list of WP-CLI commands.
#: barrio-suite-migration.php:122
#, php-format
msgid "These modules of Barrio Suite stay off until the same modules of Suite Barrio are migrated, so the site does not get them twice. Run each command with --dry-run first: %s."
msgstr ""

#: forms.php:361
msgid "Next"
msgstr ""

#. translators: 1: dry run command, 2: migration command.
#: seo.php:65
#, php-format
msgid "The SEO module of Barrio Suite stays off until the SEO of Suite Barrio is migrated: run %1$s, then %2$s. Turned on before, it prints the meta tags twice."
msgstr ""
