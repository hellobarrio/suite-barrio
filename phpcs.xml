<?xml version="1.0"?>
<ruleset name="Suite Barrio">
    <description>WordPress Coding Standards for the Suite Barrio plugin.</description>

    <file>.</file>

    <exclude-pattern>*/.phpcs-tools/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/js/*.min.js</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="8.0-"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="suite_barrio"/>
                <element value="SUITE_BARRIO"/>
                <element value="SUITE_BARRIO_Consent_Log"/>
                <element value="SUITE_BARRIO_Scanner"/>
                <element value="SUITE_BARRIO_Service_Registry"/>
                <element value="SUITE_BARRIO_Script_Blocker"/>
                <element value="SUITE_BARRIO_Cron"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <properties>
            <property name="customSanitizingFunctions" type="array">
                <element value="suite_barrio_cp_sanitize_report_script"/>
                <element value="suite_barrio_cb_sanitize_service_script"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customAutoEscapedFunctions" type="array">
                <element value="suite_barrio_build_email_html"/>
                <element value="suite_barrio_columns_empty"/>
            </property>
        </properties>
    </rule>
</ruleset>
